{
  "name": "@repo/vitest-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base": {
      "import": "./src/base.ts",
      "types": "./src/base.ts"
    },
    "./node": {
      "import": "./src/node.ts",
      "types": "./src/node.ts"
    },
    "./react": {
      "import": "./src/react.ts",
      "types": "./src/react.ts"
    },
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vitest": "^4.1.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "5.9.2"
  }
}
